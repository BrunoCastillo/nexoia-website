# Copia este archivo a .env.local. No pongas aquí la clave service_role.
# La evaluación pública usa Google Forms y no necesita Supabase.
# Pega el enlace "Enviar" del formulario, por ejemplo https://docs.google.com/forms/d/e/.../viewform

NEXT_PUBLIC_GOOGLE_FORM_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_URL=https://nexoiaec.vercel.app

# Secretos solo de Supabase Edge Functions, nunca con prefijo NEXT_PUBLIC_ ni en el navegador:
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase al desplegar la función.
# TURNSTILE_SECRET_KEY
# RATE_LIMIT_SALT
# ALLOWED_ORIGIN=https://nexoiaec.vercel.app
# ALLOW_VERCEL_PREVIEWS=false

# EmailJS (formulario de contacto). Si se dejan vacías, el sitio usa los valores actuales del código.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
